                                    <constraint firstItem="imp-scroll-content" firstAttribute="height" relation="greaterThanOrEqual" secondItem="imp-scroll-frame" secondAttribute="height" id="imp-content-min-height"/>
                                    <constraint firstItem="imp-scroll-content" firstAttribute="height" secondItem="imp-scroll-frame" secondAttribute="height" priority="250" id="imp-content-preferred-height"/>
                                    <constraint firstItem="imp-content-stack" firstAttribute="top" secondItem="imp-scroll-content" secondAttribute="top" constant="20" id="imp-content-top"/>
                                    <constraint firstItem="imp-scroll-content" firstAttribute="trailing" secondItem="imp-content-stack" secondAttribute="trailing" constant="20" id="imp-content-trailing"/>
                                    <constraint firstItem="imp-content-stack" firstAttribute="width" secondItem="imp-scroll-frame" secondAttribute="width" constant="-40" id="imp-content-width"/>
                                </constraints>
                                <viewLayoutGuide key="contentLayoutGuide" id="imp-scroll-content"/>
                                <viewLayoutGuide key="frameLayoutGuide" id="imp-scroll-frame"/>
                            </scrollView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="imp-safe-area"/>
                        <color key="backgroundColor" systemColor="systemGroupedBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="imp-scroll-view" firstAttribute="bottom" secondItem="imp-safe-area" secondAttribute="bottom" id="imp-scroll-bottom"/>
                            <constraint firstItem="imp-scroll-view" firstAttribute="leading" secondItem="imp-safe-area" secondAttribute="leading" id="imp-scroll-leading"/>
                            <constraint firstItem="imp-scroll-view" firstAttribute="top" secondItem="imp-safe-area" secondAttribute="top" id="imp-scroll-top"/>
                            <constraint firstItem="imp-scroll-view" firstAttribute="trailing" secondItem="imp-safe-area" secondAttribute="trailing" id="imp-scroll-trailing"/>
                        </constraints>
                    </view>
                    <toolbarItems>
                        <barButtonItem title="New Folder" id="imp-new-folder-item" userLabel="New Folder Button">
                            <connections>
                                <action selector="createDir:" destination="imp-view-controller" id="imp-new-folder-action"/>
                            </connections>
                        </barButtonItem>
                        <barButtonItem style="plain" systemItem="flexibleSpace" id="imp-toolbar-space"/>
                        <barButtonItem style="plain" id="imp-destination-item" userLabel="Current Destination Toolbar Label">
                            <label key="customView" opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" misplaced="YES" text="Import into Oblivion" lineBreakMode="tailTruncation" adjustsFontForContentSizeCategory="YES" id="imp-toolbar-destination">
                                <rect key="frame" x="0.0" y="0.0" width="145" height="20"/>
                                <autoresizingMask key="autoresizingMask"/>
                                <fontDescription key="fontDescription" style="UICTFontTextStyleCaption1"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                            </label>
                        </barButtonItem>
                    </toolbarItems>
                    <navigationItem key="navigationItem" title="Import PDF" id="imp-navigation-item">
                        <barButtonItem key="leftBarButtonItem" title="Cancel" id="imp-cancel-item" userLabel="Cancel Import Button">
                            <connections>
                                <action selector="cancelImport:" destination="imp-view-controller" id="imp-cancel-action"/>
                            </connections>
                        </barButtonItem>
                        <barButtonItem key="rightBarButtonItem" title="Import" style="done" id="imp-import-item" userLabel="Confirm Import Button">
                            <connections>
                                <action selector="confirmImport:" destination="imp-view-controller" id="imp-confirm-action"/>
                            </connections>
                        </barButtonItem>
                    </navigationItem>
                    <connections>
                        <outlet property="destinationPathLabel" destination="imp-destination-path" id="imp-destination-path-outlet"/>
                        <outlet property="directoryTableView" destination="imp-folder-table" id="imp-directory-table-outlet"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="imp-view-responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1700" y="0.0"/>
        </scene>
    </scenes>
